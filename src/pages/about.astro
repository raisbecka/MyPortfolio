---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE, SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'

const email = SOCIAL_LINKS.find((link) => link.label === 'Email')
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrew Raisbeck',
  url: SITE.href,
  jobTitle: 'Enterprise developer and IBM Maximo/MAS specialist',
  description:
    'Enterprise application development, IBM Maximo/MAS, systems integration and application reliability for public-sector water and wastewater operations.',
}
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:user' }]} />

  <section aria-labelledby="about-heading" class="space-y-10 pb-8">
    <header class="space-y-4">
      <h1 id="about-heading" class="text-3xl font-bold md:text-4xl">
        About me
      </h1>
      <p class="text-primary text-lg font-medium">
        Building reliable software for complex operations.
      </p>
    </header>

    <div class="space-y-6">
      <p class="text-lg leading-relaxed">
        I’m Andrew Raisbeck, an enterprise developer and IBM Maximo/MAS
        specialist. At York Region, I build applications and integrations that
        support Public Sector operations - working directly with staff to
        turn complex requirements into practical, maintainable software.
      </p>
      <p class="text-muted-foreground leading-relaxed">
        I've spent the last 10+ years putting all aspects of the software lifecycle 
        into practise. From project management, to design, development, testing
        training, as well as maintenance and support, I've had the privilege to 
        work with some incredible people and learn a tremendous amount along the way.
      </p>
      <p class="text-muted-foreground leading-relaxed">
        My Maximo experience spans custom application/solution development, core 
        enterprise asset management, extensive reporting experience and 
        infrastructure administration. During a concurrent Acting Program Manager
        assignment, I led a my team during a Maximo-to-MAS upgrade,
        cloud migration and transition to Red Hat OpenShift in just over six
        months - my biggest accomplishment yet.
      </p>
    </div>

    <section aria-labelledby="approach-heading" class="space-y-4">
      <h2 id="approach-heading" class="text-xl font-semibold">How I work</h2>
      <p class="text-muted-foreground leading-relaxed">
        Working in the public sector has taught me to make practical decisions
        within limited budgets and existing infrastructure. I’m comfortable
        maintaining established systems as well as building new applications,
        and I stay involved beyond release through training, support and ongoing
        improvement.
      </p>
      <p class="text-muted-foreground leading-relaxed">
        I’ve presented multiple times at the Canadian Maximo User Group in Toronto and enjoy
        sharing what I learn. Outside work, I spend time on open-source tools,
        AI and self-hosting projects. I also enjoy weightlifting, running,
        camping and baseball.
      </p>
    </section>

    <section
      aria-labelledby="connect-heading"
      class="border-border bg-muted/10 space-y-5 rounded-xl border p-5 sm:p-6"
    >
      <h2 id="connect-heading" class="text-xl font-semibold">Let’s talk</h2>
      <p class="text-muted-foreground leading-relaxed">
        I’m interested in developer and/or Maximo roles where I can
        build useful applications, solve challenging issues, and be an asset
        to your team.
      </p>
      <div class="flex flex-wrap gap-3">
        <Link
          href="/#maximo-experience"
          class={buttonVariants({ variant: 'outline' })}
        >
          Maximo / MAS experience
        </Link>
        <Link
          href="/#developer-experience"
          class={buttonVariants({ variant: 'outline' })}
        >
          Development experience
        </Link>
        {
          email && (
            <Link
              href={email.href}
              class={buttonVariants({ variant: 'default' })}
            >
              Email me
            </Link>
          )
        }
      </div>
    </section>
  </section>
</Layout>
