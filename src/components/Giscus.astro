---
interface Props {
  title: string
  url?: string
}

const { title, url } = Astro.props
const pageUrl = url || Astro.url.href
---

<section id="giscus-section" class="mt-12" aria-label="Comments section">
  <!--
    Standard giscus embed (config from giscus.app "Generate code").
    giscus handles lazy loading (data-loading="lazy") and, with Astro's
    ClientRouter, a fresh script element is injected per page, so each post
    resolves its own discussion via the pathname mapping. No custom loader.
  -->
  <script
    src="https://giscus.app/client.js"
    data-repo="raisbecka/MyPortfolio"
    data-repo-id="R_kgDOOsRljw"
    data-category="Blog Comments"
    data-category-id="DIC_kwDOOsRlj84DJroM"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</section>

<script is:inline>
  /**
   * Keep giscus in sync with the site's light/dark theme.
   * giscus defaults to preferred_color_scheme (OS setting); the site has a
   * manual toggle that sets <html data-theme>. We forward theme changes to
   * the giscus iframe and sync once when the lazy-loaded iframe appears.
   *
   * NOTE: Astro hoists is:inline scripts into <head>, so this runs before
   * <body> exists. Only observer registration happens here (head-safe);
   * everything else is deferred.
   */
  ;(function () {
    'use strict'

    function siteTheme() {
      return (
        document.documentElement.getAttribute('data-theme') === 'dark'
          ? 'dark'
          : 'light'
      )
    }

    function syncTheme() {
      if (window.giscus) {
        window.giscus.dispatchEvent(
          new CustomEvent('themechange', { detail: { theme: siteTheme() } }),
        )
      }
    }

    // Re-sync whenever the site theme toggle changes <html data-theme>.
    new MutationObserver(function () {
      syncTheme()
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    })

    // Sync once when the lazy-loaded giscus iframe appears in the DOM.
    // Observe <html> (not <body>) because this runs before <body> exists.
    var bodyObserver = new MutationObserver(function () {
      var frame = document.querySelector('iframe.giscus-frame')
      if (frame) {
        syncTheme()
        // The iframe's content window (window.giscus) may not be attached
        // until the iframe finishes loading, so sync again on load.
        frame.addEventListener('load', syncTheme)
        bodyObserver.disconnect()
      }
    })
    bodyObserver.observe(document.documentElement, {
      childList: true,
      subtree: true,
    })
  })()
</script>

<noscript>
  <div
    class="bg-muted/50 text-muted-foreground mt-12 rounded-lg border p-6 text-center text-sm"
  >
    <p>
      Please enable JavaScript to view the{' '}
      <a
        href={pageUrl}
        class="hover:text-foreground underline"
        rel="noopener noreferrer"
      >
        comments powered by giscus
      </a>
      .
    </p>
  </div>
</noscript>
